# ── AI model server secrets ──────────────────────────────────────────────
# These must MATCH the keys the app / Laravel send. See the table in README.md.

# Oracle chat: the app sends this as the `x-api-key` header.
# Must equal the Flutter build's --dart-define=LUMEN_API_KEY=...
LUMEN_API_KEY=lumen_default_secure_api_key_2026

# Trip Planner: Laravel forwards this as the `X-Admin-Internal-Key` header.
# Must equal Laravel .env's INTERNAL_BRIDGE_KEY (32-char secret).
INTERNAL_BRIDGE_KEY=change-me-to-a-32-char-random-secret

# Host / port the server binds to.
HOST=0.0.0.0
PORT=8000
