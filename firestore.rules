rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Core Auth Functions ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // BUG-F01 Fix: Check JWT custom claims first to eliminate billed document reads & latency
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['admin', 'super_admin'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'super_admin']
      );
    }

    function isVerifiedGuide() {
      return isSignedIn() && (
        request.auth.token.role in ['guide_approved', 'admin', 'super_admin'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['guide_approved', 'admin', 'super_admin']
      );
    }

    // ── User Profiles ────────────────────────────────────────────────────────
    // •  Users read/write THEIR OWN profile only.
    // •  Admins can read all profiles.
    // •  Users CANNOT change role, isPremium, isBanned, or any premium/flag fields.
    //    Only admins or backend service accounts elevate these fields.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) &&
                        !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny([
                            'role', 'isPremium', 'isBanned', 'expiryDate', 'premiumPlan',
                            'isFlagged', 'flagReason', 'flaggedAt',
                            'premiumRevokedAt', 'premiumRevokedReason',
                            'reviewCount', 'ratingAverage', 'ratingRecalcNeededAt',
                            'tier', 'dailyAiScans', 'scanQuotaResetAt', 'tokensUsed', 'aiQuotaLimit'
                          ])) ||
                       isAdmin();
      allow delete: if isAdmin();

      // Server-written security posture (Cloud Functions use Admin SDK, which
      // bypasses rules — this only needs to allow the owner to READ it).
      match /security/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Admin SDK only
      }
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.accountId;
      allow create: if isSignedIn() && request.resource.data.accountId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.accountId == request.auth.uid;
    }

    // ── Guide Listings (Marketplace) ─────────────────────────────────────────
    // •  Anyone authenticated can read published & approved listings.
    // •  Only the guide owning the listing or admins can write.
    match /guide_listings/{listingId} {
      allow read: if isSignedIn() &&
        (resource.data.status == 'published' && resource.data.moderationStatus == 'approved'
         || isOwner(resource.data.guideId) || isAdmin());
      allow create: if isVerifiedGuide() &&
        request.resource.data.guideId == request.auth.uid;
      allow update: if (isOwner(resource.data.guideId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['moderationStatus', 'isFeatured', 'ratingAverage', 'profileViews'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ── Guide Applications (Enrollment & Approval) ───────────────────────────
    match /guide_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (isOwner(userId) && resource.data.status == 'rejected');
      allow delete: if isAdmin();
    }

    // ── Booking Requests (Marketplace Tour Bookings) ─────────────────────────
    // Pricing/payout fields (quotedPrice, commissionAmount, guideNetAmount,
    // operatorNetAmount, payoutStatus) are backend-owned — never client-writable.
    match /booking_requests/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.touristId == request.auth.uid ||
        resource.data.guideId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['quotedPrice', 'commissionAmount', 'guideNetAmount', 'operatorNetAmount', 'payoutStatus']) &&
        (resource.data.touristId == request.auth.uid ||
         resource.data.guideId == request.auth.uid)
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Tour Packages ────────────────────────────────────────────────────────
    match /tour_packages/{packageId} {
      allow read: if isSignedIn();
      allow create: if isVerifiedGuide() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ── Tour Reviews ─────────────────────────────────────────────────────────
    // •  Reviews are public (any authenticated user can read active reviews).
    // •  Creating a review requires auth. Server-side logic verifies eligibility.
    // •  Moderation fields (status, flag, hidden) can only be changed by admins.
    match /tour_reviews/{reviewId} {
      allow read: if isSignedIn() && resource.data.moderationStatus == 'active';
      allow create: if isSignedIn() &&
        request.resource.data.touristId == request.auth.uid;
      allow update: if (isOwner(resource.data.touristId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['moderationStatus', 'isFlagged', 'flagReason', 'hiddenByAdmin', 'hiddenReason',
                   'isVerifiedSession', 'reviewWindowValidated'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ── Tour Sessions ────────────────────────────────────────────────────────
    match /tour_sessions/{sessionId} {
      allow read: if isSignedIn() || resource.data.trackingEnabled == true || resource.data.isJoinOpen == true;
      allow create: if isVerifiedGuide() &&
        request.resource.data.guideId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.guideId == request.auth.uid ||
        request.auth.uid in resource.data.touristIds ||
        (!resource.data.isLocked && resource.data.currentPhase == 'assembling' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['touristIds', 'redeemedCount']) &&
         request.auth.uid in request.resource.data.touristIds) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /presence/{presenceId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          (presenceId == request.auth.uid || presenceId.startsWith('vehicle_'));
      }

      // Meeting-point checkpoints — same participants as the parent session.
      match /checkpoints/{checkpointId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds ||
          isAdmin()
        );
        allow create, update: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }

      // Live broadcast messages — same participants as the parent session.
      match /broadcasts/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds ||
          isAdmin()
        );
        // Only the guide sends broadcasts; tourists may only update to acknowledge.
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid;
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          (request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy'])) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ── Tour Links (QR Connect) ──────────────────────────────────────────────
    // guideId/touristId are immutable after creation to prevent link hijacking.
    match /tour_links/{linkId} {
      allow read: if isSignedIn() && (resource.data.touristId == request.auth.uid || resource.data.guideId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['guideId', 'touristId']) &&
        (resource.data.touristId == request.auth.uid || resource.data.guideId == request.auth.uid)
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Family Share Links (Live Tracking & Safety) ─────────────────────────
    // Owner (tourist) creates/deletes and can deactivate; the anonymous
    // recipient viewing an active link may only ever bump viewCount.
    match /family_share_links/{shareId} {
      allow get: if (isSignedIn() && resource.data.touristId == request.auth.uid) ||
        (resource.data.isActive == true && resource.data.expiresAt > request.time);
      allow list: if isSignedIn() && resource.data.touristId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.touristId == request.auth.uid &&
          request.resource.data.touristId == resource.data.touristId) ||
        (resource.data.isActive == true && resource.data.expiresAt > request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
      allow delete: if isSignedIn() && resource.data.touristId == request.auth.uid;
    }

    // ── Operator Accounts (Fleet/Team Management) ────────────────────────────
    match /operator_accounts/{operatorId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUserId == request.auth.uid ||
        request.auth.uid in resource.data.teamGuideIds ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid;
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isPremium', 'premiumPlanId', 'premiumExpiresAt', 'autoRenew']) &&
        resource.data.ownerUserId == request.auth.uid
      ) || isAdmin();
      allow delete: if isOwner(resource.data.ownerUserId) || isAdmin();
    }

    // ── Vehicles ─────────────────────────────────────────────────────────────
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.guideId == request.auth.uid ||
        request.resource.data.operatorId == request.auth.uid
      );
      allow update, delete: if isOwner(resource.data.guideId) ||
        isOwner(resource.data.operatorId) || isAdmin();
      allow delete: if isAdmin();
    }



    // ── Places & Events (Discovery) ──────────────────────────────────────────
    match /places/{placeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Saved Plans ──────────────────────────────────────────────────────────
    match /saved_plans/{planId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Business Partners ────────────────────────────────────────────────────
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── AR Sessions ─────────────────────────────────────────────────────────
    match /ar_sessions/{sessionId} {
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.hostUid == request.auth.uid || request.auth.uid in resource.data.participantUids || isAdmin());
      allow update: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids']) &&
         request.auth.uid in request.resource.data.participantUids) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.hostUid == request.auth.uid || isAdmin());
    }

    // ── Knowledge Base Config ────────────────────────────────────────────────
    match /kb_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── App Config (Remote Config Cache) ────────────────────────────────────
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── AI Logs (Immutable Audit Trail) ─────────────────────────────────────
    // Writes are by backend Admin SDK only. No client writes.
    match /ai_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Location Pings (Anti-Spoof Telemetry) ───────────────────────────────
    // Users write their own (for server audit). Only admins can read.
    // Immutable after creation.
    match /location_pings/{pingId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Incident Reports ───────────────────────────────────────────────────
    match /incident_reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── SOS Alerts (Safety-Critical) ────────────────────────────────────────
    // Any signed-in tour participant can trigger an SOS; only admins review them.
    match /sos_alerts/{alertId} {
      allow create: if isSignedIn() &&
        request.resource.data.triggeredBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Abuse Reports / Events ──────────────────────────────────────────────
    match /abuse_reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Self-instrumentation: client reports suspicious activity involving its
    // own account (promo abuse bursts, impossible-movement anomalies).
    match /abuse_events/{eventId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Security Events (Phase 3: Behavioral Telemetry) ───────────────────
    // Users can CREATE their own security events (client-side telemetry).
    // Only admins can READ (forensic review).
    // No updates or deletes — immutable audit trail.
    match /security_events/{eventId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Security Alerts (Point 13: Incident Response) ────────────────────
    match /security_alerts/{alertId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Pending Notifications (Point 13: FCM Escalation) ─────────────────
    match /pending_notifications/{notiId} {
      allow create: if isSignedIn();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── User Notifications (In-App Push & Alerts) ────────────────────────
    match /user_notifications/{notiId} {
      allow read, update, delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn();
    }

    // ── Device Trust Graph (Phase 3: Account-Device Bindings) ────────────
    match /device_trust/{bindingId} {
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Quarantined Sessions (Phase 3: Auto-Containment Records) ─────────
    match /quarantined_sessions/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only
    }

    // ── Explorer Progress (Level/Badges Gamification) ────────────────────
    match /user_progress/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── AR Treasure Hunt Gamification ─────────────────────────────────────
    match /user_gamification/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── Community Memory Drops (Geo-tagged public posts) ──────────────────
    match /community_memories/{memoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── AR Content Locations (Read-only, admin-managed) ────────────────────
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Subscription Plan Definitions (Read-only, admin-managed) ──────────
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Risk Config (Fraud/Abuse Detection Rules — admin-managed) ─────────
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Guide Analytics Snapshots (Trust Score) ────────────────────────────
    // Read-your-own is fine; writes must come from a trusted server-side job,
    // not the guide's own client, to prevent self-inflated trust scores.
    match /guide_analytics/{snapshotId} {
      allow read: if isSignedIn() && (resource.data.guideId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Threat Notifications (Security Telemetry) ──────────────────────────
    match /threat_notifications/{notiId} {
      allow create: if true; // May fire before/without auth (dev-tooling/debugger probes)
      allow read, update, delete: if isAdmin();
    }
  }
}

