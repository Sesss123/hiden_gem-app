rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Core Auth Functions ──────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // BUG-F01 Fix: Check JWT custom claims first to eliminate billed document reads & latency
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role in ['admin', 'super_admin'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['admin', 'super_admin']
      );
    }

    function isVerifiedGuide() {
      return isSignedIn() && (
        request.auth.token.role in ['guide_approved', 'admin', 'super_admin'] ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['guide_approved', 'admin', 'super_admin']
      );
    }

    // ── User Profiles ────────────────────────────────────────────────────────
    // •  Users read/write THEIR OWN profile only.
    // •  Admins can read all profiles.
    // •  Users CANNOT change role, isPremium, isBanned, or any premium/flag fields.
    //    Only admins or backend service accounts elevate these fields.
    // •  isGuideApproved/guideStatus are a narrower case: the client (see
    //    GuideApplicationRepository.getMyApplication()) legitimately mirrors
    //    an already-approved/rejected status from guide_applications/{userId}
    //    (admin-owned) onto the user's own profile after confirming it via
    //    Laravel. Rather than block the fields outright and break that sync,
    //    the write is only allowed when it matches the real, current status
    //    on guide_applications/{userId} — a client can't fabricate approval
    //    without an admin having actually set it there first.
    function guideStatusWriteMatchesApplication(userId) {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      let guideFields = ['isGuideApproved', 'guideStatus', 'guideRejectionReason'];
      let touchesGuideFields = diffKeys.hasAny(guideFields);
      let onlyTouchesGuideFields = diffKeys.hasOnly(guideFields);
      let appStatus = get(/databases/$(database)/documents/guide_applications/$(userId)).data.status;
      return !touchesGuideFields || (
        onlyTouchesGuideFields &&
        (!('guideStatus' in request.resource.data) || request.resource.data.guideStatus == appStatus) &&
        (!('isGuideApproved' in request.resource.data) || request.resource.data.isGuideApproved == (appStatus == 'approved'))
      );
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if (isOwner(userId) &&
                        !request.resource.data.diff(resource.data)
                          .affectedKeys().hasAny([
                            'role', 'isPremium', 'isBanned', 'expiryDate', 'premiumPlan',
                            'isFlagged', 'flagReason', 'flaggedAt',
                            'premiumRevokedAt', 'premiumRevokedReason',
                            'reviewCount', 'ratingAverage', 'ratingRecalcNeededAt',
                            'tier', 'dailyAiScans', 'scanQuotaResetAt', 'tokensUsed', 'aiQuotaLimit'
                          ]) &&
                        guideStatusWriteMatchesApplication(userId)) ||
                       isAdmin();
      allow delete: if isAdmin();

      // Server-written security posture (Cloud Functions use Admin SDK, which
      // bypasses rules — this only needs to allow the owner to READ it).
      match /security/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false; // Admin SDK only
      }
    }

    match /subscriptions/{subId} {
      allow read: if isSignedIn() && request.auth.uid == resource.data.accountId;
      allow create: if isSignedIn() && request.resource.data.accountId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.accountId == request.auth.uid;
    }

    // ── Guide Listings (Marketplace) ─────────────────────────────────────────
    // •  Anyone authenticated can read published & approved listings.
    // •  Only the guide owning the listing or admins can write.
    match /guide_listings/{listingId} {
      // A guide's own listing doc is keyed by their uid and won't exist yet
      // before they've ever saved one — the editor screen probes for it via
      // getListing(uid) on first open. Firestore rules can't reference a
      // nonexistent doc's fields, so !exists() must be checked first (allow
      // signed-in read of "nothing's there" — no data is exposed either way).
      allow read: if isSignedIn() &&
        (!exists(/databases/$(database)/documents/guide_listings/$(listingId))
         || resource.data.status == 'published' && resource.data.moderationStatus == 'approved'
         || isOwner(resource.data.guideId) || isAdmin());
      allow create: if isVerifiedGuide() &&
        request.resource.data.guideId == request.auth.uid;
      allow update: if (isOwner(resource.data.guideId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['moderationStatus', 'isFeatured', 'ratingAverage', 'profileViews'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ── Guide Applications (Enrollment & Approval) ───────────────────────────
    // A rejected applicant may resubmit (edit their own answers/documents),
    // but must never be able to set `status` themselves — only an admin
    // review can move status to 'approved'/'rejected'. Without this,
    // guideStatusWriteMatchesApplication() on users/{userId} would let a
    // rejected applicant forge their own "approved" guide badge.
    match /guide_applications/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && request.resource.data.status == 'pending';
      allow update: if isAdmin() || (
        isOwner(userId) && resource.data.status == 'rejected' &&
        request.resource.data.status == 'pending'
      );
      allow delete: if isAdmin();
    }

    // ── Booking Requests (Marketplace Tour Bookings) ─────────────────────────
    // Pricing/payout fields (quotedPrice, commissionAmount, guideNetAmount,
    // operatorNetAmount, payoutStatus) are backend-owned — never client-writable.
    // guideId/touristId are immutable after creation (same rationale as
    // tour_links — prevents hijacking a booking to point at a different
    // account). status transitions (pending -> accepted/declined/
    // session_ready/completed) are only ever driven guide-side in the app
    // (BookingInboxScreen.respondToRequest — there is no tourist-facing
    // status writer), so only the guide may change status; the tourist
    // retains write access for non-status fields (e.g. notes) on their own
    // booking.
    match /booking_requests/{bookingId} {
      allow read: if isSignedIn() && (
        resource.data.touristId == request.auth.uid ||
        resource.data.guideId == request.auth.uid ||
        isAdmin()
      );
      // Security: BookingRepository.submitRequest() never sets a price/payout
      // on creation — those fields stay null until a real guide-side/backend
      // quoting step runs — so a legitimate create() always writes null
      // money fields, status:'pending', payoutStatus:'pending'. Enforcing
      // that shape here closes a gap where the UPDATE rule protected these
      // fields but CREATE didn't: a raw client could otherwise fabricate a
      // brand-new booking already marked quotedPrice/guideNetAmount/
      // payoutStatus:'paid'/status:'completed', which would then flow
      // straight into the guide's own earnings dashboard and
      // TourSessionRepository.endSession()'s commission math as if real.
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (!('payoutStatus' in request.resource.data) || request.resource.data.payoutStatus == 'pending') &&
        (!('quotedPrice' in request.resource.data) || request.resource.data.quotedPrice == null) &&
        (!('commissionAmount' in request.resource.data) || request.resource.data.commissionAmount == null) &&
        (!('guideNetAmount' in request.resource.data) || request.resource.data.guideNetAmount == null) &&
        (!('operatorNetAmount' in request.resource.data) || request.resource.data.operatorNetAmount == null);
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['quotedPrice', 'commissionAmount', 'guideNetAmount', 'operatorNetAmount', 'payoutStatus',
                   'guideId', 'touristId']) &&
        (
          resource.data.guideId == request.auth.uid ||
          (resource.data.touristId == request.auth.uid &&
           !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']))
        )
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Tour Packages ────────────────────────────────────────────────────────
    match /tour_packages/{packageId} {
      allow read: if isSignedIn();
      allow create: if isVerifiedGuide() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.ownerId) || isAdmin();
    }

    // ── Tour Reviews ─────────────────────────────────────────────────────────
    // •  Reviews are public (any authenticated user can read active reviews).
    // •  Creating a review requires auth AND is now verified against the real
    //    session doc directly in rules (see reviewEligibleForSession below) —
    //    ReviewRepository.submitReview()'s eligibility/window/duplicate
    //    checks are real, but were previously client-side only, so a raw
    //    Firestore write could fabricate a review for a session that never
    //    happened, or wasn't completed, or wasn't eligible for review yet.
    // •  Moderation fields (status, flag, hidden) can only be changed by admins.
    function reviewEligibleForSession(reviewData) {
      let session = get(/databases/$(database)/documents/tour_sessions/$(reviewData.sessionId)).data;
      // Note: the review-window expiry (reviewWindowEndsAt) is intentionally
      // NOT re-checked here. It's stored as a Dart .toIso8601String() in
      // local (non-UTC) time, which can't be safely compared against
      // request.time (rules has no string-to-timestamp cast, and a plain
      // string compare across mismatched timezone/precision formats risks
      // wrongly rejecting or accepting reviews near the boundary). It stays
      // a client-side check (ReviewRepository.submitReview) — a review
      // submitted slightly outside the window is a soft business-rule
      // nuisance, not a trust/money exploit, given every field that matters
      // (real completed session, real eligible participant, real guideId)
      // is enforced below.
      return session.status == 'completed' &&
        reviewData.guideId == session.guideId &&
        request.auth.uid in session.reviewEligibleTouristIds;
    }
    match /tour_reviews/{reviewId} {
      allow read: if isSignedIn() && resource.data.moderationStatus == 'active';
      // Duplicate-review prevention: ReviewRepository.submitReview() now
      // keys the doc ID as "{sessionId}_{touristId}" and writes via
      // .create() (fails if the doc already exists) instead of a
      // check-then-write query — this closes a real race where N parallel
      // submissions could each see "no existing review" and all succeed.
      // Enforcing the ID shape here too means even a raw client that skips
      // the repository entirely still can't create a second review for the
      // same session+tourist pair — Firestore's own create-if-absent
      // semantics on a fixed path is the actual atomicity guarantee, not
      // application code.
      allow create: if isSignedIn() &&
        request.resource.data.touristId == request.auth.uid &&
        reviewId == request.resource.data.sessionId + '_' + request.auth.uid &&
        request.resource.data.overallRating is number &&
        request.resource.data.overallRating >= 1 && request.resource.data.overallRating <= 5 &&
        reviewEligibleForSession(request.resource.data);
      allow update: if (isOwner(resource.data.touristId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['moderationStatus', 'isFlagged', 'flagReason', 'hiddenByAdmin', 'hiddenReason',
                   'isVerifiedSession', 'reviewWindowValidated'])) ||
        isAdmin();
      allow delete: if isAdmin();
    }

    // ── Tour Sessions ────────────────────────────────────────────────────────
    match /tour_sessions/{sessionId} {
      // Only actual participants (guide/tourist) or admins may read a
      // session once it's live (trackingEnabled == true exposes live GPS +
      // the join/session code for the whole tour duration — this must never
      // be public, signed-in or not). The one legitimate public case is
      // isJoinOpen == true: the pre-tour "assembling" phase, where a
      // tourist who isn't a participant yet needs to preview the session to
      // join it via code — that window ends (isJoinOpen is cleared) once
      // the tour actually starts, well before trackingEnabled ever turns on.
      allow read: if resource.data.isJoinOpen == true ||
        (isSignedIn() && (
          resource.data.guideId == request.auth.uid ||
          request.auth.uid in resource.data.touristIds ||
          isAdmin()
        ));
      allow create: if isVerifiedGuide() &&
        request.resource.data.guideId == request.auth.uid;
      allow update: if isSignedIn() && (
        resource.data.guideId == request.auth.uid ||
        request.auth.uid in resource.data.touristIds ||
        (!resource.data.isLocked && resource.data.currentPhase == 'assembling' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['touristIds', 'redeemedCount']) &&
         request.auth.uid in request.resource.data.touristIds) ||
        isAdmin()
      );
      allow delete: if isAdmin();

      match /presence/{presenceId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() &&
          (presenceId == request.auth.uid || presenceId.matches('^vehicle_.*'));
      }

      // Meeting-point checkpoints — same participants as the parent session.
      match /checkpoints/{checkpointId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds ||
          isAdmin()
        );
        allow create, update: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }

      // Live broadcast messages — same participants as the parent session.
      match /broadcasts/{messageId} {
        allow read: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds ||
          isAdmin()
        );
        // Only the guide sends broadcasts; tourists may only update to acknowledge.
        allow create: if isSignedIn() &&
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid;
        allow update: if isSignedIn() && (
          get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.guideId == request.auth.uid ||
          (request.auth.uid in get(/databases/$(database)/documents/tour_sessions/$(sessionId)).data.touristIds &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acknowledgedBy'])) ||
          isAdmin()
        );
        allow delete: if isAdmin();
      }
    }

    // ── Tour Links (QR Connect) ──────────────────────────────────────────────
    // guideId/touristId are immutable after creation to prevent link hijacking.
    match /tour_links/{linkId} {
      allow read: if isSignedIn() && (resource.data.touristId == request.auth.uid || resource.data.guideId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['guideId', 'touristId']) &&
        (resource.data.touristId == request.auth.uid || resource.data.guideId == request.auth.uid)
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Family Share Links (Live Tracking & Safety) ─────────────────────────
    // Owner (tourist) creates/deletes and can deactivate; the anonymous
    // recipient viewing an active link may only ever bump viewCount.
    match /family_share_links/{shareId} {
      allow get: if (isSignedIn() && resource.data.touristId == request.auth.uid) ||
        (resource.data.isActive == true && resource.data.expiresAt > request.time);
      allow list: if isSignedIn() && resource.data.touristId == request.auth.uid;
      // Note: expiresAt is stored as a Dart .toIso8601String() (local,
      // non-UTC time — see FamilyShareLink.toJson()), not a Firestore
      // Timestamp, so it can't be safely compared against request.time here
      // (same class of issue found and avoided in tour_reviews' review
      // window check earlier this audit — see that rule's comment for why).
      // A create-time expiry cap and a per-tourist link-count cap both stay
      // out of rules for now rather than risk a broken/inconsistent check;
      // flagging as a follow-up: migrate expiresAt to a real Timestamp field
      // so both an expiry ceiling and correct anonymous-read gating (the
      // existing `get`/`update` rules below have the same string-vs-timestamp
      // mismatch) can be enforced correctly.
      allow create: if isSignedIn() && request.resource.data.touristId == request.auth.uid;
      allow update: if (isSignedIn() && resource.data.touristId == request.auth.uid &&
          request.resource.data.touristId == resource.data.touristId) ||
        (resource.data.isActive == true && resource.data.expiresAt > request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount']));
      allow delete: if isSignedIn() && resource.data.touristId == request.auth.uid;
    }

    // ── Operator Accounts (Fleet/Team Management) ────────────────────────────
    // teamGuideIds requires the named guide's own consent to join — the
    // owner can only stage an invite into pendingTeamGuideIds (which the
    // OperatorRepository.inviteGuideToTeam() client already does), never
    // write teamGuideIds directly. Previously the owner could arrayUnion
    // any uid straight into teamGuideIds with no acknowledgement from that
    // guide at all — this let any operator silently brand an unrelated
    // guide as "their" team member.
    function operatorTeamChangeIsConsented() {
      let diffKeys = request.resource.data.diff(resource.data).affectedKeys();
      // Owner removing a guide from teamGuideIds (dismissal) — always allowed.
      let ownerRemoval = diffKeys.hasOnly(['teamGuideIds']) &&
        resource.data.teamGuideIds.hasAll(request.resource.data.teamGuideIds) &&
        resource.data.ownerUserId == request.auth.uid;
      // The invited guide accepting: they must be the one calling this,
      // moving exactly their own uid from pending -> team.
      let guideAccepts = diffKeys.hasOnly(['pendingTeamGuideIds', 'teamGuideIds']) &&
        request.auth.uid in resource.data.pendingTeamGuideIds &&
        !(request.auth.uid in resource.data.teamGuideIds) &&
        request.resource.data.teamGuideIds.hasAll(resource.data.teamGuideIds) &&
        request.resource.data.teamGuideIds.hasAll([request.auth.uid]) &&
        !(request.auth.uid in request.resource.data.pendingTeamGuideIds);
      // The guide leaving on their own (removing themselves).
      let guideLeaves = diffKeys.hasOnly(['teamGuideIds']) &&
        request.auth.uid in resource.data.teamGuideIds &&
        !(request.auth.uid in request.resource.data.teamGuideIds) &&
        resource.data.teamGuideIds.hasAll(request.resource.data.teamGuideIds);
      return !diffKeys.hasAny(['teamGuideIds']) || ownerRemoval || guideAccepts || guideLeaves;
    }
    match /operator_accounts/{operatorId} {
      allow read: if isSignedIn() && (
        resource.data.ownerUserId == request.auth.uid ||
        request.auth.uid in resource.data.teamGuideIds ||
        request.auth.uid in resource.data.pendingTeamGuideIds ||
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.ownerUserId == request.auth.uid &&
        (!('teamGuideIds' in request.resource.data) || request.resource.data.teamGuideIds == [request.auth.uid]);
      allow update: if isSignedIn() && (
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isPremium', 'premiumPlanId', 'premiumExpiresAt', 'autoRenew']) &&
        (resource.data.ownerUserId == request.auth.uid || request.auth.uid in resource.data.teamGuideIds || request.auth.uid in resource.data.pendingTeamGuideIds) &&
        operatorTeamChangeIsConsented()
      ) || isAdmin();
      allow delete: if isOwner(resource.data.ownerUserId) || isAdmin();
    }

    // ── Guide Client Notes (CRM) ─────────────────────────────────────────────
    // Private guide-authored notes about a tourist they've booked. Doc ID is
    // {guideId}_{touristId} — only the authoring guide (or admin) may
    // read/write. Create is checked against the incoming doc (no existing
    // resource yet); read/update/delete against the existing doc.
    match /guide_client_notes/{noteId} {
      allow read, update, delete: if isSignedIn() &&
        (resource.data.guideId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.guideId == request.auth.uid;
    }

    // ── Vehicles ─────────────────────────────────────────────────────────────
    // guideId/operatorId are immutable after creation (same rationale as
    // tour_links/booking_requests) — previously an operator or guide owner
    // could rewrite either field on update with no restriction, letting an
    // operator silently reassign a vehicle away from the guide actually
    // using it (or claim it for themselves) with no consent from the other
    // party.
    match /vehicles/{vehicleId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        request.resource.data.guideId == request.auth.uid ||
        request.resource.data.operatorId == request.auth.uid
      );
      allow update: if ((isOwner(resource.data.guideId) || isOwner(resource.data.operatorId)) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['guideId', 'operatorId'])) ||
        isAdmin();
      allow delete: if isOwner(resource.data.guideId) || isOwner(resource.data.operatorId) || isAdmin();
    }



    // ── Places & Events (Discovery) ──────────────────────────────────────────
    match /places/{placeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Saved Plans ──────────────────────────────────────────────────────────
    match /saved_plans/{planId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ── Business Partners ────────────────────────────────────────────────────
    match /partners/{partnerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── AR Sessions ─────────────────────────────────────────────────────────
    match /ar_sessions/{sessionId} {
      allow create: if isSignedIn() && request.resource.data.hostUid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.hostUid == request.auth.uid || request.auth.uid in resource.data.participantUids || isAdmin());
      allow update: if isSignedIn() && (
        resource.data.hostUid == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUids']) &&
         request.auth.uid in request.resource.data.participantUids) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (resource.data.hostUid == request.auth.uid || isAdmin());
    }

    // ── Knowledge Base Config ────────────────────────────────────────────────
    match /kb_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── App Config (Remote Config Cache) ────────────────────────────────────
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── AI Logs (Immutable Audit Trail) ─────────────────────────────────────
    // Writes are by backend Admin SDK only. No client writes.
    match /ai_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Location Pings (Anti-Spoof Telemetry) ───────────────────────────────
    // Users write their own (for server audit). Only admins can read.
    // Immutable after creation.
    match /location_pings/{pingId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Incident Reports ───────────────────────────────────────────────────
    match /incident_reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── SOS Alerts (Safety-Critical) ────────────────────────────────────────
    // Any signed-in tour participant can trigger an SOS; only admins review them.
    match /sos_alerts/{alertId} {
      allow create: if isSignedIn() &&
        request.resource.data.triggeredBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Abuse Reports / Events ──────────────────────────────────────────────
    match /abuse_reports/{reportId} {
      allow create: if isSignedIn() &&
        request.resource.data.reportedBy == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Self-instrumentation: client reports suspicious activity involving its
    // own account (promo abuse bursts, impossible-movement anomalies).
    match /abuse_events/{eventId} {
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // ── Security Events (Phase 3: Behavioral Telemetry) ───────────────────
    // Users can CREATE their own security events (client-side telemetry).
    // Only admins can READ (forensic review).
    // No updates or deletes — immutable audit trail.
    match /security_events/{eventId} {
      allow create: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Security Alerts (Point 13: Incident Response) ────────────────────
    // SecurityAlertService.triggerAlert() always sets `userId` to either the
    // reporting device's own uid or null (a device-level anomaly with no
    // specific user) — never an arbitrary other uid. Previously any signed-in
    // user could forge a high-severity alert naming a victim uid with no
    // constraint at all, to get a trusting admin to manually act on it.
    match /security_alerts/{alertId} {
      allow create: if isSignedIn() &&
        (!('userId' in request.resource.data) || request.resource.data.userId == null ||
         request.resource.data.userId == request.auth.uid) &&
        request.resource.data.severity in ['low', 'medium', 'high', 'critical'];
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── Pending Notifications (Point 13: FCM Escalation) ─────────────────
    // Always machine-generated by SecurityAlertService._sendPushNotification
    // right after writing security_alerts above — constrain to that same
    // known shape (topic/status) so a signed-in user can't queue an
    // arbitrary FCM push to admins.
    match /pending_notifications/{notiId} {
      allow create: if isSignedIn() &&
        request.resource.data.topic is string &&
        request.resource.data.status == 'queued';
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ── User Notifications (In-App Push & Alerts) ────────────────────────
    // Legitimate writers (BookingRepository, functions/index.ts) always
    // target ANOTHER user's recipientId by design (a guide notifying their
    // tourist and vice versa), so this can't require
    // recipientId == request.auth.uid the way most other collections do.
    // Instead constrain the write to the known real shape/type-allowlist —
    // previously `allow create: if isSignedIn()` had no constraint at all,
    // letting any signed-in user forge a trusted-looking notification
    // ("✅ Booking accepted!") to any victim's recipientId with arbitrary
    // title/body content (a social-engineering/spam vector surfaced
    // directly by NotificationService as an in-app toast/snackbar).
    match /user_notifications/{notiId} {
      allow read, update, delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn() &&
        request.resource.data.recipientId is string &&
        request.resource.data.type in ['new_booking', 'booking_response', 'subscription_expired', 'subscription_reminder'] &&
        request.resource.data.title is string && request.resource.data.title.size() <= 200 &&
        request.resource.data.body is string && request.resource.data.body.size() <= 1000;
    }

    // ── Device Trust Graph (Phase 3: Account-Device Bindings) ────────────
    match /device_trust/{bindingId} {
      allow create, update: if isSignedIn() &&
        request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow delete: if isAdmin();
    }

    // ── Quarantined Sessions (Phase 3: Auto-Containment Records) ─────────
    match /quarantined_sessions/{uid} {
      allow read: if isAdmin();
      allow write: if false; // Admin SDK only
    }

    // ── Join Attempts (rate-limit state for validateJoinToken) ───────────
    // Written exclusively by the validateJoinToken Cloud Function (Admin
    // SDK, bypasses rules) — clients must never read or write their own
    // attempt counter directly, or they could reset it themselves and
    // defeat the rate limit it exists to enforce.
    match /join_attempts/{uid} {
      allow read, write: if false; // Admin SDK only
    }

    // ── Explorer Progress (Level/Badges Gamification) ────────────────────
    match /user_progress/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // ── AR Treasure Hunt Gamification ─────────────────────────────────────
    // points/found_artifacts are unbounded client-set values by design (no
    // money/trust impact — a vanity leaderboard stat), but a raw write could
    // still fabricate an arbitrarily large score with zero real artifacts
    // found. Require points to only ever increase, by a sane per-write
    // ceiling (well above any single real artifact's value — see
    // ARArtifact.points, defaulting to 100), and found_artifacts to only
    // grow, never shrink/replace (can't "unfind" something to game a rank).
    match /user_gamification/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
        request.resource.data.points is int && request.resource.data.points >= 0 &&
        request.resource.data.points <= 10000;
      allow update: if isOwner(userId) &&
        request.resource.data.points is int &&
        request.resource.data.points >= resource.data.points &&
        request.resource.data.points <= resource.data.points + 10000 &&
        (!('found_artifacts' in resource.data) || !('found_artifacts' in request.resource.data) ||
         request.resource.data.found_artifacts.hasAll(resource.data.found_artifacts));
      allow write: if isAdmin();
    }

    // ── Community Memory Drops (Geo-tagged public posts) ──────────────────
    match /community_memories/{memoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ── AR Content Locations (Read-only, admin-managed) ────────────────────
    match /locations/{locationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Subscription Plan Definitions (Read-only, admin-managed) ──────────
    match /plans/{planId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Risk Config (Fraud/Abuse Detection Rules — admin-managed) ─────────
    match /config/{configId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ── Guide Analytics Snapshots (Trust Score) ────────────────────────────
    // Read-your-own is fine; writes must come from a trusted server-side job,
    // not the guide's own client, to prevent self-inflated trust scores.
    match /guide_analytics/{snapshotId} {
      allow read: if isSignedIn() && (resource.data.guideId == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Threat Notifications (Security Telemetry) ──────────────────────────
    // Must stay anonymous-writable by design (ThreatReporter.reportSpectreBreach
    // fires on pre-login debugger/tamper probes, before request.auth exists —
    // requiring isSignedIn() here would blind the app to exactly the
    // adversarial-probe case this collection exists to catch). What was
    // missing was any shape constraint: previously `allow create: if true`
    // accepted arbitrary fields/values, letting anyone forge a fabricated
    // high-severity report naming an arbitrary victim uid to get a human
    // admin to act on it. Constrain to the real shape ThreatReporter sends,
    // and require category/severity to be one of its actual known values.
    match /threat_notifications/{notiId} {
      allow create: if request.resource.data.keys().hasOnly(
          ['category', 'severity', 'uid', 'signals', 'timestamp', 'appVersion', 'buildNumber', 'status', 'details']) &&
        request.resource.data.category is string &&
        request.resource.data.severity in ['low', 'medium', 'high', 'critical'] &&
        request.resource.data.uid is string &&
        (!isSignedIn() || request.resource.data.uid == request.auth.uid || request.resource.data.uid == 'UNAUTHENTICATED_PROBE');
      allow read, update, delete: if isAdmin();
    }
  }
}

