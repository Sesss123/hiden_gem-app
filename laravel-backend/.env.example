APP_NAME="Hidden Gems SL Gateway"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8888

# Add your machine's LAN IP here (matching AppConfig's dev-default IP in the
# Flutter app) so on-device testing over Wi-Fi gets stateful Sanctum cookies.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,127.0.0.1:8888

# 🛡️ Phase 4: Hidden Gems SL Security & Python Microservice Connection
PYTHON_BACKEND_URL=http://localhost:8000
INTERNAL_BRIDGE_KEY=YOUR_32_CHAR_INTERNAL_API_KEY_HERE
API_KEY=YOUR_32_CHAR_PUBLIC_API_KEY_HERE

# Shared secret for the 'zenith' request-signature middleware
# (VerifyZenithSignature). Must match AppConfig.sharedSecret (HMAC_SECRET
# dart-define) in the Flutter app. If left unset, signature verification
# fails OPEN (requests pass unverified) rather than breaking the app — but
# that means production silently runs without this protection until set.
HMAC_SECRET=

# RevenueCat webhook shared secret — set the same value in the
# RevenueCat dashboard (Project Settings > Webhooks > Authorization header).
REVENUECAT_WEBHOOK_SECRET=

# PayHere (booking payment gateway). Get these from your PayHere merchant
# dashboard. Keep PAYHERE_SANDBOX=true (with the sandbox merchant id/secret)
# while testing; set false + live credentials for production. In the PayHere
# dashboard, set the "Notify URL" allowed domain to your API host.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
PAYHERE_COMMISSION_RATE=0.10

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Laravel Reverb (WebSocket server) — REVERB_APP_KEY must match the key
# hardcoded in the Flutter client's reverbWsUrl (lib/core/config/app_config.dart).
REVERB_APP_ID=
REVERB_APP_KEY=hiddengems_reverb_key
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
